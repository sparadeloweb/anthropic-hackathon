# Google Maps Platform API Key — used by /sales-finding-leads
# Works with any Google Maps Platform key (Maps, Places, Routes share the same key)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Make sure "Places API (New)" is enabled in APIs & Services > Library
GOOGLE_PLACES_API_KEY=your-api-key-here

# Google Stitch API Key — used by /design-generating-websites
# Get yours at: https://stitch.withgoogle.com (Settings > API Keys)
# Also configure via: claude mcp add stitch --transport http https://stitch.googleapis.com/mcp --header "X-Goog-Api-Key: YOUR-KEY" -s user
STITCH_API_KEY=your-api-key-here
